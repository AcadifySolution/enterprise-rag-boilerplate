# Copy to .env for local development. Never commit .env or real credentials.

APP_NAME="Enterprise RAG Boilerplate"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Required in staging/production. Leave empty for local development.
API_KEY=
# Comma-separated browser origins. Do not use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vector database: pgvector, qdrant, pinecone
VECTOR_DB_TYPE=qdrant

# pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_documents

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-index

# Chunking and embedding
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=text-embedding-3-small
PII_MASKING_ENABLED=true
