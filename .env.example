# App Configuration
APP_NAME="Enterprise RAG Boilerplate"
APP_ENV=development  # development, staging, production
APP_HOST=0.0.0.0
APP_PORT=8000
API_KEY=dev-api-key-secure-12345

# LLM Gateway
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Vector Database Selection: pgvector, qdrant, pinecone
VECTOR_DB_TYPE=qdrant

# pgvector (PostgreSQL) Config
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# Qdrant Config
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_documents

# Pinecone Config
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-index

# Chunking & Semantic Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=text-embedding-3-small
PII_MASKING_ENABLED=true
